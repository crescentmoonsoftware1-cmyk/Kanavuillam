# Backend Environment Variables
PORT=3000

# Supabase Configuration (Required for database operations)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-or-anon-key

# Razorpay Configuration (Optional for payment gateway testing)
RAZORPAY_KEY_ID=rzp_test_placeholder
RAZORPAY_KEY_SECRET=placeholder_secret

# AI Models (Optional - used for AI blueprint parsing & recommendations)
GEMINI_API_KEY=your_gemini_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
REPLICATE_API_TOKEN=your_replicate_api_token

# Python executable path (if using local CV pipeline)
PYTHON_PATH=py
