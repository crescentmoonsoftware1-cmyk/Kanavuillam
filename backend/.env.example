# ─── Kanavu Illam Backend Configuration ──────────────────────────────────────
PORT=3000
NODE_ENV=production

# ─── Supabase Configuration ──────────────────────────────────────────────────
# Required for database operations and authentication verification
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_KEY=your-supabase-anon-key

# ─── Razorpay Configuration ──────────────────────────────────────────────────
# Required for project unlock payments & webhook confirmation
RAZORPAY_KEY_ID=rzp_live_placeholder
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# ─── Allowed CORS Domains ────────────────────────────────────────────────────
# Comma-separated list of allowed web origins
ALLOWED_ORIGINS=https://kanavuillam.in,https://www.kanavuillam.in,https://kanavuillam.vercel.app,http://localhost:3000

# ─── AI Models & Computer Vision Pipeline ────────────────────────────────────
# OpenRouter API key for live construction material price and brand search
OPENROUTER_API_KEY=your_openrouter_api_key

# Python executable path (py or python3)
PYTHON_PATH=py
